rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users / Profiles ──────────────────────────────────────────────────────
    // Users can read/write their own profile. Admins can read all profiles.
    match /profiles/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == "admin"
      );
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Onboarding Responses ──────────────────────────────────────────────────
    match /onboarding_responses/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Workout Sessions ──────────────────────────────────────────────────────
    match /workout_sessions/{sessionId} {
      allow read: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.user_id == request.auth.uid;
    }

    // ── Session Metrics ───────────────────────────────────────────────────────
    match /session_metrics/{metricId} {
      allow read: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.user_id == request.auth.uid;
    }

    // ── Pose Graphs ───────────────────────────────────────────────────────────
    match /pose_graphs/{graphId} {
      allow read: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.user_id == request.auth.uid;
    }

    // ── Daily Stats ───────────────────────────────────────────────────────────
    match /daily_stats/{statId} {
      allow read: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.user_id == request.auth.uid;
    }

    // ── Admin-only collections ────────────────────────────────────────────────
    match /admin/{document=**} {
      allow read, write: if request.auth != null &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == "admin";
    }
  }
}
