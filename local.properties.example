# local.properties.example - copy to local.properties and fill
# Android and Firebase configuration for local debug

# Google Sign-In
#GOOGLE_WEB_CLIENT_ID_DEBUG=your-web-client-id.apps.googleusercontent.com
#GOOGLE_WEB_CLIENT_ID_RELEASE=your-web-client-id.apps.googleusercontent.com

# Groq AI (for coaching feedback)
#GROQ_API_KEY=your-groq-api-key

# Release signing (generate keystore first: keytool -genkeypair ...)
#RELEASE_STORE_PASSWORD=your-keystore-password
#RELEASE_KEY_ALIAS=posemonitor
#RELEASE_KEY_PASSWORD=your-key-password
